{
    "url": "%endpoint%/openai/deployments/%model%/chat/completions?api-version=%api_version%",

    "header": {
        "content-type": "application/json",
        "api-key": "%api_key%"
    },

    "request": {
        "[max_tokens]": "%max_tokens%",
        "[max_completion_tokens]": "%max_completion_tokens%",
        "[temperature]": "%temperature%",
        "[reasoning_effort]": "%reasoning_effort%",
        "messages": "%message%",
        "[tools]": "%tool%"
    },

    "user": {
        "role": "user",
        "content": "%text%"
    },

    "assistant": "%reply%",

    "tool": {
        "type": "function",
        "function": {
            "name": "%name%",
            "description": "%description%",
            "parameters": "%schema%"
        }
    },

    "text": {
        "user": "content",
        "assistant": "content",
        "system": "content",
        "result": "content",
        "reasoning": "reasoning_content"
    },

    "value": {
        "reason": "choices/0/finish_reason",
        "reply": "choices/0/message",
        "call": "choices/0/message/tool_calls",
        "error": ["error/message", "error", "message"]
    },

    "usage": {
        "input": "usage/prompt_tokens",
        "cache": "usage/prompt_tokens_details/cached_tokens",
        "output": "usage/completion_tokens"
    },

    "cache_in_input": true,

    "action": {
        "stop": "stop",
        "content_filter": "stop",
        "length": "resume",
        "tool_calls": "tool"
    },

    "call": {
        "id": "id",
        "name": "function/name",
        "argument": "function/arguments",
        "type": "function",
        "argument_encode": true
    },

    "synthetic": {
        "role": "assistant",
        "content": "%text%",
        "tool_calls": "%call%"
    },

    "result": {
        "block": {
            "role": "tool",
            "tool_call_id": "%id%",
            "content": "%content%"
        },
        "part": {
            "response": 16777216,
            "text": {
                "type": "text",
                "text": "%text%"
            },
            "binary": [
                {
                    "mime": "/^image\\//",
                    "block": {
                        "type": "image_url",
                        "image_url": {
                            "url": "data:%mime%;base64,%data%"
                        }
                    }
                },
                {
                    "mime": "/^audio\\/(x-)?wav$/",
                    "block": {
                        "type": "input_audio",
                        "input_audio": {
                            "data": "%data%",
                            "format": "wav"
                        }
                    }
                },
                {
                    "mime": "/^audio\\/mpeg$/",
                    "block": {
                        "type": "input_audio",
                        "input_audio": {
                            "data": "%data%",
                            "format": "mp3"
                        }
                    }
                },
                {
                    "mime": "/./",
                    "block": {
                        "type": "file",
                        "file": {
                            "[filename]": "%uri%",
                            "file_data": "data:%mime%;base64,%data%"
                        }
                    }
                }
            ],
            "attach": {
                "role": "user",
                "content": "%content%"
            }
        }
    },

    "compact": {
        "binary": "content"
    },

    "system": {
        "role": "system",
        "content": "%system%"
    },

    "default": {
        "api_version": "2024-10-21",
        "max_tokens": 16384
    },

    "required": [
        "endpoint",
        "model",
        "api_key"
    ],

    "prefill": false,
    "reasoning_replay": false,
    "overflow": "/(?<![a-z])(context|length|prompt|request|token|window)(?![a-z]).*(?<![a-z])(allowed|bound|exceed|exhaust|limit|max|overflow|too long)|(?<![a-z])max(imum)?(?![a-z]).*(?<![a-z])(context|length|token)(?![a-z])/i",
    "retry": "/overload|temporar|try again later|rate.?limit|slow.?down|unavailable|capacity|busy/i"
}
